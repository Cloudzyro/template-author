# Where the newsletter form sends sign-ups (Buttondown, ConvertKit, Formspree, a Supabase function or similar).
# Falls back to PUBLIC_FORM_ENDPOINT, then to opening the visitor's email app.
PUBLIC_NEWSLETTER_ENDPOINT=

# Used by the newsletter form when PUBLIC_NEWSLETTER_ENDPOINT is empty (Formspree, Basin or similar).
PUBLIC_FORM_ENDPOINT=

# Your site's public address, used for the sitemap, canonical links and social previews.
SITE_URL=https://example.com
