---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1 class="display h1">This page is checked out</h1>
    <p class="lede">We couldn't find it. The books are all still on the shelf.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/books">See the books</a>
      <a class="btn btn-quiet" href="/">Home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: 120px 160px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
