---
import Base from "../layouts/Base.astro";
import { author } from "../data/site";
---

<Base title="About" description={author.shortBio}>
  <section class="wrap about">
    <figure class="portrait" aria-label="Portrait placeholder: replace with an author photo">
      <svg viewBox="0 0 300 375" aria-hidden="true">
        <rect width="300" height="375" fill="var(--raised)" />
        <rect x="40" y="0" width="70" height="375" fill="var(--line)" />
        <circle cx="150" cy="150" r="58" fill="var(--ink-3)" opacity="0.35" />
        <path d="M54 375c6-76 46-118 96-118s90 42 96 118z" fill="var(--ink-3)" opacity="0.35" />
      </svg>
      <figcaption class="muted">Replace with an author photo, 4:5</figcaption>
    </figure>
    <div class="text">
      <h1 class="display h1">About Marian</h1>
      {author.longBio.map((p) => <p>{p}</p>)}
      <p class="contact">
        Write to Marian at <a class="text-link" href={`mailto:${author.email}`}>{author.email}</a>. For rights, contact {author.agent.name} at{" "}
        {author.agent.agency}.
      </p>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 7vw, 112px);
    padding-block: clamp(40px, 6vw, 72px) 112px;
    align-items: start;
  }
  .portrait svg {
    width: 100%;
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: 8px;
    font-size: 13px;
  }
  .text {
    display: grid;
    gap: 18px;
    font-size: 19px;
    max-width: 38rem;
  }
  .text h1 {
    margin-bottom: 8px;
  }
  .contact {
    font-size: 16px;
    color: var(--ink-2);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: min(70%, 280px);
    }
  }
</style>
