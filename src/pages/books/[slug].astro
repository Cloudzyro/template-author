---
import Base from "../../layouts/Base.astro";
import BookCover from "../../components/BookCover.astro";
import DateStamp from "../../components/DateStamp.astro";
import { author, books, praiseNote, type Book } from "../../data/site";

export function getStaticPaths() {
  return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book: b } = Astro.props as { book: Book };
const schema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: b.title,
  author: { "@type": "Person", name: author.name },
  publisher: { "@type": "Organization", name: b.publisher },
  datePublished: b.release,
  numberOfPages: b.pages,
  description: b.hook,
  workExample: b.formats.map((f) => ({ "@type": "Book", bookFormat: f.name, isbn: f.isbn })),
};
---

<Base title={b.title} description={`${b.title} by ${author.name}. ${b.hook}`} schema={schema}>
  <section class="wrap top">
    <div class="cover-col">
      <BookCover book={b} size="l" />
    </div>
    <div class="info">
      <p class="crumb muted"><a href="/books">Books</a></p>
      <h1 class="display h1">{b.title}</h1>
      <div class="release">
        {b.upcoming ? <DateStamp date={b.release} label="Out" /> : <DateStamp date={b.release} label="Published" />}
        <span class="muted">{b.publisher} &middot; <span class="tnum">{b.pages}</span> pages</span>
      </div>
      <p class="hook">{b.hook}</p>
      <div class="buy">
        <h2 class="sr">Where to buy</h2>
        <a class="btn btn-primary" href={b.buy[0].href} rel="noopener">{b.upcoming ? "Preorder" : "Buy"} from {b.buy[0].label.toLowerCase()}</a>
        <ul>
          {b.buy.slice(1).map((l) => <li><a class="text-link" href={l.href} rel="noopener">{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap body">
    <div class="main">
      <h2 class="display h2">About the book</h2>
      {b.synopsis.map((p) => <p>{p}</p>)}

      <h2 class="display h2 excerpt-title">From the book</h2>
      <div class="excerpt">
        {b.excerpt.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <aside>
      <h2 class="sr">Praise</h2>
      {
        b.praise.map((q) => (
          <blockquote>
            <p class="display">{q.quote}</p>
            <footer class="muted">{q.source}</footer>
          </blockquote>
        ))
      }
      <p class="note muted">{praiseNote}</p>
      <dl class="formats">
        {
          b.formats.map((f) => (
            <div>
              <dt>{f.name}</dt>
              <dd class="tnum">ISBN {f.isbn}</dd>
            </div>
          ))
        }
      </dl>
      <p class="note muted">ISBNs are samples.</p>
    </aside>
  </section>
</Base>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 64px) 80px;
  }
  .cover-col {
    width: min(100%, 340px);
    justify-self: center;
  }
  .info {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .crumb {
    font-size: 15px;
  }
  .crumb a {
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--ink);
  }
  .release {
    display: flex;
    gap: 16px;
    align-items: center;
    font-size: 15px;
  }
  .hook {
    font-size: 21px;
    line-height: 1.5;
    max-width: 32rem;
  }
  .buy {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .buy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 15px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: clamp(40px, 7vw, 112px);
    padding-block: 64px 112px;
    border-top: 1px solid var(--line-strong);
  }
  .main {
    display: grid;
    gap: 16px;
    align-content: start;
    font-size: 18px;
    max-width: 38rem;
  }
  .excerpt-title {
    margin-top: 40px;
  }
  .excerpt {
    display: grid;
    gap: 16px;
    padding: 28px 32px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--display);
    font-size: 21px;
    line-height: 1.6;
  }
  .excerpt p + p {
    text-indent: 1.5em;
  }
  aside {
    display: grid;
    gap: 32px;
    align-content: start;
  }
  blockquote p {
    font-size: 24px;
    line-height: 1.35;
  }
  blockquote footer {
    margin-top: 8px;
    font-size: 14px;
  }
  .note {
    font-size: 13px;
    margin-top: -16px;
  }
  .formats {
    display: grid;
    gap: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .formats div {
    display: grid;
    gap: 0;
  }
  .formats dd {
    margin: 0;
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .top,
    .body {
      grid-template-columns: 1fr;
    }
    .cover-col {
      width: min(70%, 260px);
    }
    .excerpt {
      padding: 20px;
      font-size: 19px;
    }
  }
</style>
