---
import Base from "../../layouts/Base.astro";
import BookCover from "../../components/BookCover.astro";
import { author, books } from "../../data/site";
---

<Base title="Books" description={`Novels by ${author.name}.`}>
  <header class="wrap head">
    <h1 class="display h1">Books</h1>
    <p class="lede">Four novels, one of them still at the printer.</p>
  </header>

  <ul class="wrap list">
    {
      books.map((b) => (
        <li>
          <a class="cover" href={`/books/${b.slug}`} tabindex="-1" aria-hidden="true">
            <BookCover book={b} size="m" />
          </a>
          <div class="text">
            <p class="muted meta tnum">
              {b.upcoming ? `Out ${new Date(b.release + "T12:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}` : b.year} &middot; {b.publisher}
            </p>
            <h2 class="display">
              <a href={`/books/${b.slug}`}>{b.title}</a>
            </h2>
            <p class="hook">{b.hook}</p>
            <a class="text-link" href={`/books/${b.slug}`}>
              {b.upcoming ? "Preorder and read an excerpt" : "Read more and buy"}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head {
    padding-block: clamp(40px, 6vw, 72px) 48px;
  }
  .lede {
    margin-top: 12px;
  }
  .list {
    padding-bottom: 112px;
  }
  li {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-block: 40px;
    border-top: 1px solid var(--line);
  }
  .meta {
    font-size: 15px;
  }
  h2 {
    font-size: clamp(32px, 3.6vw, 44px);
    margin-top: 4px;
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .hook {
    margin-block: 12px 16px;
    font-size: 19px;
    color: var(--ink-2);
    max-width: 34rem;
  }
  @media (max-width: 600px) {
    li {
      grid-template-columns: 110px minmax(0, 1fr);
      gap: 20px;
      align-items: start;
    }
    .hook {
      font-size: 16px;
    }
  }
</style>
