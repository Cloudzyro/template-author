---
import Base from "../layouts/Base.astro";
import BookCover from "../components/BookCover.astro";
import DateStamp from "../components/DateStamp.astro";
import EventList from "../components/EventList.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { author, books, newsletter } from "../data/site";
import { upcoming } from "../lib/events";

const next = books.find((b) => b.upcoming) ?? books[0];
const backlist = books.filter((b) => b !== next);
---

<Base>
  <section class="hero wrap">
    <div class="cover-col">
      <a href={`/books/${next.slug}`} class="cover-link">
        <BookCover book={next} size="l" />
      </a>
    </div>
    <div class="copy">
      <div class="release">
        <DateStamp date={next.release} label="Out" />
        <span class="muted">{next.publisher}</span>
      </div>
      <h1 class="display h1">{next.title}</h1>
      <p class="hook">{next.hook}</p>
      <blockquote class="praise">
        <p class="display">{next.praise[0].quote}</p>
        <footer class="muted">{next.praise[0].source}</footer>
      </blockquote>
      <div class="actions">
        <a class="btn btn-primary" href={next.buy[0].href} rel="noopener">Preorder from your local bookstore</a>
        <a class="btn btn-quiet" href={`/books/${next.slug}`}>Read an excerpt</a>
      </div>
      <p class="more">
        Also from <a class="text-link" href={next.buy[1].href} rel="noopener">online booksellers</a>, as an{" "}
        <a class="text-link" href={next.buy[2].href} rel="noopener">ebook</a> and an{" "}
        <a class="text-link" href={next.buy[3].href} rel="noopener">audiobook read by the author</a>
      </p>
    </div>
  </section>

  <section class="shelf-band" aria-labelledby="books-title">
    <div class="wrap">
      <div class="head">
        <h2 id="books-title" class="display h2">Also by {author.name.split(" ")[0]}</h2>
        <a class="text-link" href="/books">All books</a>
      </div>
      <ul class="shelf">
        {
          backlist.map((b) => (
            <li>
              <a href={`/books/${b.slug}`}>
                <BookCover book={b} size="m" />
                <span class="b-title display">{b.title}</span>
                <span class="muted tnum">{b.year}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap events" aria-labelledby="events-title">
    <div class="head">
      <h2 id="events-title" class="display h2">Coming up</h2>
      <a class="text-link" href="/events">All events</a>
    </div>
    <EventList list={upcoming.slice(0, 3)} />
  </section>

  <section class="wrap split" aria-labelledby="about-title">
    <div>
      <h2 id="about-title" class="display h2">About</h2>
      <p class="bio">{author.shortBio}</p>
      <a class="text-link" href="/about">More about Marian</a>
    </div>
    <div class="nl">
      <h2 class="display h2">{newsletter.title}</h2>
      <p class="muted">{newsletter.text}</p>
      <NewsletterForm />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 64px) clamp(64px, 8vw, 96px);
  }
  .cover-col {
    display: grid;
    justify-items: center;
  }
  .cover-link {
    width: min(100%, 360px);
  }
  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .release {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 15px;
  }
  .hook {
    font-size: 20px;
    line-height: 1.5;
    max-width: 32rem;
  }
  .praise {
    padding-left: 20px;
    border-left: 2px solid var(--line-strong);
    max-width: 32rem;
  }
  .praise p {
    font-size: 21px;
    line-height: 1.4;
  }
  .praise footer {
    margin-top: 6px;
    font-size: 14px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .more {
    font-size: 15px;
    color: var(--ink-2);
    max-width: 32rem;
  }
  .shelf-band {
    background: var(--raised);
    padding-block: 72px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .shelf {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 200px));
    gap: 48px;
  }
  .shelf a {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }
  .shelf :global(.cover) {
    margin-bottom: 10px;
    transition: transform 200ms var(--ease);
  }
  .shelf a:hover :global(.cover) {
    transform: translateY(-2px);
  }
  .b-title {
    font-size: 22px;
  }
  .events {
    padding-block: 96px 64px;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    padding-block: 64px 112px;
    border-top: 1px solid var(--line-strong);
  }
  .split > div {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
  }
  .bio {
    font-size: 18px;
    max-width: 32rem;
  }
  @media (max-width: 860px) {
    .hero,
    .split {
      grid-template-columns: 1fr;
    }
    .cover-link {
      width: min(70%, 280px);
    }
    .shelf {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .b-title {
      font-size: 18px;
    }
  }
  @media (max-width: 480px) {
    .shelf {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
