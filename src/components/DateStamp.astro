---
// The signature: dates set like a library due-date stamp. Used only for dates.
interface Props {
  date: string; // YYYY-MM-DD
  label?: string;
}
const { date, label } = Astro.props;
const [y, m, d] = date.split("-").map(Number);
const month = new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" });
const full = new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<time class="stamp" datetime={date} title={full}>
  {label && <span class="label">{label}</span>}
  <span class="d tnum">{month} {d}</span>
  <span class="y tnum">{y}</span>
</time>

<style>
  .stamp {
    display: inline-grid;
    justify-items: center;
    gap: 0;
    min-width: 76px;
    padding: 6px 10px 5px;
    border: 1.5px solid var(--stamp);
    border-radius: 3px;
    color: var(--stamp);
    font-family: var(--font);
    line-height: 1.15;
    transform: rotate(-2deg);
  }
  .label {
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .d {
    font-size: 17px;
    font-weight: 500;
  }
  .y {
    font-size: 12px;
  }
</style>
